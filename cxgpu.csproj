<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Local dev: use ConsoleEx project reference when available as sibling repo.
       cxgpu lives at source/cxgpu/, so ConsoleEx is one level up (../ConsoleEx),
       NOT two (cxtop is a level deeper, hence its ../../). -->
  <ItemGroup Condition="Exists('../ConsoleEx/SharpConsoleUI/SharpConsoleUI.csproj')">
    <ProjectReference Include="../ConsoleEx/SharpConsoleUI/SharpConsoleUI.csproj" />
  </ItemGroup>
  <!-- CI/release: use NuGet package -->
  <ItemGroup Condition="!Exists('../ConsoleEx/SharpConsoleUI/SharpConsoleUI.csproj')">
    <PackageReference Include="SharpConsoleUI" Version="2.5.23" />
  </ItemGroup>

  <!-- cxgpu.Tests/ has its own .csproj. The SDK's default **/*.cs glob would otherwise pull its
       sources into the app assembly (and drag xunit references in with them), so exclude the whole
       directory here. Same reason ConsoleEx excludes its nested aot.test/ project. -->
  <ItemGroup>
    <Compile Remove="cxgpu.Tests/**/*.cs" />
    <None Remove="cxgpu.Tests/**/*" />
  </ItemGroup>

  <!-- The app is a single Exe with everything internal; the test project consumes those internals
       rather than forcing types public purely to be testable. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>cxgpu.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
